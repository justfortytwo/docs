{
  "mcpServers": {
    "fortytwo-memory": {
      "command": "npx",
      "args": ["-y", "-p", "@justfortytwo/memory", "-p", "@justfortytwo/transcript", "fortytwo-memory"],
      "env": {
        "DB_PATH": "db/fortytwo.db",
        "EMBED_MODEL": "qwen3-embedding:0.6b",
        "OLLAMA_BASE_URL": "http://ollama:11434",
        "FORTYTWO_MCP_EXTENSIONS": "@justfortytwo/transcript"
      }
    },
    "whatsapp-work": {
      "type": "http",
      "url": "https://YOUR-WAHA-HOST/mcp",
      "headers": { "X-Api-Key": "${WAHA_MCP_KEY_WORK}" }
    },
    "whatsapp-personal": {
      "type": "http",
      "url": "https://YOUR-WAHA-HOST/mcp",
      "headers": { "X-Api-Key": "${WAHA_MCP_KEY_PERSONAL}" }
    }
  }
}
