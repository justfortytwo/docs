# Copy to ./waha.env (do NOT commit).
# WAHA_API_KEY = "sha512:" + sha512 hex of WAHA_API_KEY_PLAIN
#   printf %s "$PLAIN" | sha512sum | cut -d' ' -f1
# (required with WAHA_APPS_ENABLED: the plain key alone makes WAHA exit at boot)
WAHA_API_KEY=CHANGEME
WAHA_API_KEY_PLAIN=CHANGEME
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=CHANGEME
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=CHANGEME
# Uncomment if GOWS has DNS problems
# GODEBUG=netdns=go
