# Copy to ./workspace/.env (do NOT commit). Loaded by `source` in the
# claude-code container and by `fortytwo start` in the fortytwo container.
# `fortytwo init` writes or updates part of these variables.

# --- fortytwo memory (MCP) ---
OLLAMA_BASE_URL=http://ollama:11434
EMBED_MODEL=qwen3-embedding:0.6b
DB_PATH=db/fortytwo.db

# --- Telegram channel ---
TELEGRAM_BOT_TOKEN=CHANGEME

# --- WAHA MCP: one app key per WhatsApp session (optional, later) ---
WAHA_MCP_KEY_WORK=CHANGEME
WAHA_MCP_KEY_PERSONAL=CHANGEME
